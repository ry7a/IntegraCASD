// Esquema do banco do IntegraCASD.
// Convenções (valem para todas as tabelas):
// - Modelos e campos em camelCase no código; tabelas e colunas em snake_case no banco (@map / @@map).
// - Chave primária uuid.
// - Dinheiro em centavos, como Int.
// - Nada é excluído fisicamente: use situação (inativação) ou estorno.

generator client {
  provider            = "prisma-client"
  // Cliente gerado fica dentro de src/ para o TypeScript compilar junto. Está no .gitignore.
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  // O tsconfig usa "nodenext", que exige a extensão .js nos imports.
  importFileExtension = "js"
  // Índice parcial: usado no CPF único só entre alunos ativos.
  previewFeatures     = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Acesso e auditoria
// ---------------------------------------------------------------------------

enum PerfilUsuario {
  ADMINISTRATIVO
  DIRETORIA

  @@map("perfil_usuario")
}

model Usuario {
  id               String        @id @default(uuid()) @db.Uuid
  nome             String
  email            String        @unique
  senhaHash        String        @map("senha_hash")
  perfil           PerfilUsuario
  ativo            Boolean       @default(true)
  tentativasFalhas Int           @default(0) @map("tentativas_falhas")
  bloqueadoAte     DateTime?     @map("bloqueado_ate")
  ultimoAcessoEm   DateTime?     @map("ultimo_acesso_em")
  dataCriacao      DateTime      @default(now()) @map("data_criacao")
  dataAlteracao    DateTime      @updatedAt @map("data_alteracao")

  sessoes              Sessao[]
  registrosDeAuditoria RegistroAuditoria[]
  parametrosAlterados  ParametrosCobranca[]
  cobrancasEmitidas    Cobranca[]
  configuracoesAsaas   ConfiguracaoAsaas[]

  @@map("usuarios")
}

// O token em claro existe somente no cookie. O banco guarda seu SHA-256.
// O perfil fica na sessao para que uma mudanca de permissao valha no proximo acesso.
model Sessao {
  id          String        @id @default(uuid()) @db.Uuid
  usuarioId   String        @map("usuario_id") @db.Uuid
  usuario     Usuario       @relation(fields: [usuarioId], references: [id], onDelete: Restrict)
  tokenHash   String        @unique @map("token_hash") @db.Char(64)
  perfil      PerfilUsuario
  expiraEm    DateTime      @map("expira_em")
  revogadaEm  DateTime?     @map("revogada_em")
  dataCriacao DateTime      @default(now()) @map("data_criacao")

  @@index([usuarioId])
  @@index([expiraEm])
  @@map("sessoes")
}

// Esta tabela e somente de inclusao: nao existe caso de uso para alterar ou excluir registros.
model RegistroAuditoria {
  id         String   @id @default(uuid()) @db.Uuid
  usuarioId  String?  @map("usuario_id") @db.Uuid
  usuario    Usuario? @relation(fields: [usuarioId], references: [id], onDelete: Restrict)
  operacao   String
  entidade   String
  registroId String?  @map("registro_id")
  detalhe    String
  ocorridoEm DateTime @default(now()) @map("ocorrido_em")

  @@index([usuarioId])
  @@index([ocorridoEm])
  @@map("registros_auditoria")
}

// ---------------------------------------------------------------------------
// Cadastros
// ---------------------------------------------------------------------------

// Valores de enum sem acento nem espaço (exigência do Prisma).
// O texto exibido na tela ("Intercâmbio", "Aluno militar") fica no frontend.
enum SituacaoAluno {
  MATRICULADO
  TRANCADO
  DESLIGADO
  FORMADO
  INTERCAMBIO

  @@map("situacao_aluno")
}

enum PostoAluno {
  CIVIL
  ALUNO_MILITAR
  ASP_OF

  @@map("posto_aluno")
}

enum CursoAluno {
  AER
  ELE
  MEC
  CIV
  COMP
  AESP

  @@map("curso_aluno")
}

// Turma é tabela, e não enum: uma turma nova é só um registro novo, sem migração.
model Turma {
  id            String   @id @default(uuid()) @db.Uuid
  nome          String   @unique // ex.: "T28"
  dataCriacao   DateTime @default(now()) @map("data_criacao")
  dataAlteracao DateTime @updatedAt @map("data_alteracao")

  alunos Aluno[]

  @@map("turmas")
}

// Cada registro é uma vaga: bloco + apartamento + vaga.
model Alojamento {
  id            String   @id @default(uuid()) @db.Uuid
  bloco         String
  apto          String
  vaga          String
  dataCriacao   DateTime @default(now()) @map("data_criacao")
  dataAlteracao DateTime @updatedAt @map("data_alteracao")

  alunos Aluno[]

  @@unique([bloco, apto, vaga])
  @@map("alojamentos")
}

model Aluno {
  id            String        @id @default(uuid()) @db.Uuid
  nome          String
  cpf           String        @db.Char(11) // só dígitos, sem pontuação
  email         String
  matricula     Int?          @unique
  posto         PostoAluno?
  curso         CursoAluno?
  turmaId       String?       @map("turma_id") @db.Uuid
  turma         Turma?        @relation(fields: [turmaId], references: [id], onDelete: Restrict)
  celular       String?
  apelido       String?
  alojamentoId  String?       @map("alojamento_id") @db.Uuid
  alojamento    Alojamento?   @relation(fields: [alojamentoId], references: [id], onDelete: Restrict)
  cobrancas     Cobranca[]
  clienteAsaas  ClienteAsaas?
  // Define quem entra na cobrança recorrente. Inativar = ativo false (nunca excluir).
  // É a "situação" do cadastro (ativo ou inativo) [Cadastros.RF001].
  ativo         Boolean       @default(true)
  dataCriacao   DateTime      @default(now()) @map("data_criacao")
  dataAlteracao DateTime      @updatedAt @map("data_alteracao")

  // Obsoletos: substituídos por `ativo` e por `alojamentoId`. Ficam até a carga inicial
  // preencher os campos novos; depois saem numa migração própria (expandir e depois contrair).
  situacao        SituacaoAluno?
  alojamentoTexto String?        @map("alojamento")
  apto            String?
  vaga            String?

  // CPF único só entre alunos ativos (índice parcial): um aluno inativo
  // não impede o recadastro da mesma pessoa.
  @@unique([cpf], map: "alunos_cpf_ativo_key", where: { ativo: true })
  // Pelo mesmo motivo, uma vaga tem no máximo um aluno ativo; os inativos guardam a vaga antiga.
  @@unique([alojamentoId], map: "alunos_alojamento_ativo_key", where: { ativo: true })
  @@index([turmaId])
  @@map("alunos")
}

// [Cadastros.RF002]. O pagamento efetivo é sempre uma movimentação de saída vinculada ao funcionário.
model Funcionario {
  id                        String    @id @default(uuid()) @db.Uuid
  nome                      String
  cpf                       String    @db.Char(11) // só dígitos, sem pontuação
  cargo                     String
  salarioReferenciaCentavos Int       @map("salario_referencia_centavos") // informativo
  dataAdmissao              DateTime  @map("data_admissao") @db.Date
  dataDesligamento          DateTime? @map("data_desligamento") @db.Date
  ativo                     Boolean   @default(true)
  dataCriacao               DateTime  @default(now()) @map("data_criacao")
  dataAlteracao             DateTime  @updatedAt @map("data_alteracao")

  movimentacoes Movimentacao[]

  @@unique([cpf], map: "funcionarios_cpf_ativo_key", where: { ativo: true })
  @@map("funcionarios")
}

enum PeriodicidadeContrato {
  MENSAL
  ANUAL
  POR_DEMANDA
  UNICA

  @@map("periodicidade_contrato")
}

// "Vigente" e "vence em breve" são calculados a partir das datas; aqui só fica se foi encerrado.
enum SituacaoContrato {
  ATIVO
  ENCERRADO

  @@map("situacao_contrato")
}

// [Cadastros.RF004]. A contraparte é só um nome: não há cadastro de fornecedores.
model Contrato {
  id                        String                @id @default(uuid()) @db.Uuid
  codigo                    String                @unique // ex.: "24C002" (ano + C + sequência)
  contraparte               String
  objeto                    String
  valorCentavos             Int                   @map("valor_centavos") // por periodicidade
  periodicidade             PeriodicidadeContrato
  dataInicio                DateTime              @map("data_inicio") @db.Date
  dataFim                   DateTime?             @map("data_fim") @db.Date // nulo = indeterminado
  situacao                  SituacaoContrato      @default(ATIVO)
  dataEncerramento          DateTime?             @map("data_encerramento") @db.Date
  justificativaEncerramento String?               @map("justificativa_encerramento")
  dataCriacao               DateTime              @default(now()) @map("data_criacao")
  dataAlteracao             DateTime              @updatedAt @map("data_alteracao")

  movimentacoes Movimentacao[]

  @@map("contratos")
}

// Os três primeiros contam como "em andamento" na tela; os dois últimos, como "encerrados".
enum SituacaoProjeto {
  A_LIBERAR
  LIBERADO
  EM_EXECUCAO
  EXECUTADO
  CANCELADO

  @@map("situacao_projeto")
}

// [Cadastros.RF005]
model Projeto {
  id                        String          @id @default(uuid()) @db.Uuid
  codigo                    String          @unique // ex.: "25P013" (ano + P + sequência)
  nome                      String
  responsavel               String?
  dataInicio                DateTime        @map("data_inicio") @db.Date
  dataFim                   DateTime?       @map("data_fim") @db.Date
  orcamentoPrevistoCentavos Int?            @map("orcamento_previsto_centavos") // nulo = sem orçamento
  situacao                  SituacaoProjeto @default(A_LIBERAR)
  dataCriacao               DateTime        @default(now()) @map("data_criacao")
  dataAlteracao             DateTime        @updatedAt @map("data_alteracao")

  movimentacoes Movimentacao[]

  @@map("projetos")
}

// Destino de gastos de manutenção sem contrato nem projeto (ex.: "Jardins", "Hidráulica Geral").
model CentroCusto {
  id            String   @id @default(uuid()) @db.Uuid
  nome          String   @unique
  descricao     String? // o que pode ser comprado com esta verba
  ativo         Boolean  @default(true)
  dataCriacao   DateTime @default(now()) @map("data_criacao")
  dataAlteracao DateTime @updatedAt @map("data_alteracao")

  verbas        VerbaMensal[]
  movimentacoes Movimentacao[]

  @@map("centros_custo")
}

// Quanto foi liberado para um centro de custo num mês. O saldo é calculado (liberado − saídas).
model VerbaMensal {
  id                    String      @id @default(uuid()) @db.Uuid
  centroCustoId         String      @map("centro_custo_id") @db.Uuid
  centroCusto           CentroCusto @relation(fields: [centroCustoId], references: [id], onDelete: Restrict)
  ano                   Int
  mes                   Int // 1 a 12 (CHECK no banco)
  valorLiberadoCentavos Int         @map("valor_liberado_centavos")
  dataCriacao           DateTime    @default(now()) @map("data_criacao")
  dataAlteracao         DateTime    @updatedAt @map("data_alteracao")

  @@unique([centroCustoId, ano, mes])
  @@map("verbas_mensais")
}

// ---------------------------------------------------------------------------
// Cobranças (integração com o Asaas)
// ---------------------------------------------------------------------------

// Um registro por evento recebido no webhook do Asaas. O webhook só grava aqui e enfileira;
// quem processa é o worker.
model EventoWebhook {
  id            String    @id @default(uuid()) @db.Uuid
  // Id do evento no Asaas (ex.: "evt_..."). UNIQUE é o que garante a idempotência:
  // um evento repetido não consegue ser gravado duas vezes. [Confiabilidade.NF003]
  idAsaas       String    @unique @map("id_asaas")
  tipo          String // ex.: "PAYMENT_RECEIVED"
  // Corpo original da requisição, guardado como veio, para reprocessar ou investigar depois.
  payload       Json
  // Preenchido pelo worker, na mesma transação da baixa. Nulo = ainda não processado.
  processadoEm  DateTime? @map("processado_em")
  // [Cobranças.RF005] fluxo E1 e [Cobranças.RF006] fluxo E2: o evento foi processado, mas precisa de
  // conferência humana (cobrança não encontrada, pagamento de cobrança já baixada à mão). Nulo = nada a conferir.
  pendencia     String?
  dataCriacao   DateTime  @default(now()) @map("data_criacao")
  dataAlteracao DateTime  @updatedAt @map("data_alteracao")

  @@map("eventos_webhook")
}

// ---------------------------------------------------------------------------
// Movimentações
// ---------------------------------------------------------------------------

enum TipoConta {
  CORRENTE
  APLICACAO

  @@map("tipo_conta")
}

// Conta bancária do CASD. O saldo é calculado: saldo inicial + entradas − saídas.
model Conta {
  id                   String    @id @default(uuid()) @db.Uuid
  nome                 String    @unique // ex.: "Conta corrente", "Aplicação renda fixa"
  tipo                 TipoConta
  saldoInicialCentavos Int       @map("saldo_inicial_centavos") // pode ser negativo
  dataSaldoInicial     DateTime  @map("data_saldo_inicial") @db.Date
  ativo                Boolean   @default(true)
  dataCriacao          DateTime  @default(now()) @map("data_criacao")
  dataAlteracao        DateTime  @updatedAt @map("data_alteracao")

  movimentacoes      Movimentacao[]
  parametrosCobranca ParametrosCobranca[]

  @@map("contas")
}

enum TipoCategoria {
  ENTRADA
  SAIDA
  AMBOS

  @@map("tipo_categoria")
}

// [Administração.RF002]. Eixo dos indicadores de gasto por categoria.
model Categoria {
  id            String        @id @default(uuid()) @db.Uuid
  nome          String
  tipo          TipoCategoria
  ativo         Boolean       @default(true)
  dataCriacao   DateTime      @default(now()) @map("data_criacao")
  dataAlteracao DateTime      @updatedAt @map("data_alteracao")

  movimentacoes         Movimentacao[]
  parametrosMensalidade ParametrosCobranca[] @relation("CategoriaMensalidade")
  parametrosAvulsa      ParametrosCobranca[] @relation("CategoriaAvulsa")

  // Nome único só entre as ativas: uma categoria inativa não impede recriar o nome.
  @@unique([nome], map: "categorias_nome_ativa_key", where: { ativo: true })
  @@map("categorias")
}

enum TipoMovimentacao {
  ENTRADA
  SAIDA

  @@map("tipo_movimentacao")
}

enum FormaPagamento {
  ASAAS
  PIX
  TRANSFERENCIA
  DINHEIRO
  CARTAO

  @@map("forma_pagamento")
}

// Quem criou a movimentação. Só as de origem MANUAL podem ser estornadas [Movimentações.RF002].
enum OrigemMovimentacao {
  MANUAL
  CONCILIACAO_AUTOMATICA
  REGISTRO_MANUAL_DE_COBRANCA
  ESTORNO

  @@map("origem_movimentacao")
}

// Toda entrada ou saída de dinheiro [Movimentações.RF001]. Nunca é alterada nem apagada:
// a correção é um estorno, que é outra movimentação apontando para esta.
// Regras garantidas por CHECK na migração (o Prisma não descreve CHECK):
// - valorCentavos > 0 (o sinal vem do tipo);
// - no máximo um vínculo de origem: contrato, projeto, funcionário ou centro de custo;
// - origem ESTORNO se, e somente se, estornoDeId está preenchido, e aí motivoEstorno é obrigatório.
model Movimentacao {
  id             String             @id @default(uuid()) @db.Uuid
  contaId        String             @map("conta_id") @db.Uuid
  conta          Conta              @relation(fields: [contaId], references: [id], onDelete: Restrict)
  tipo           TipoMovimentacao
  valorCentavos  Int                @map("valor_centavos")
  data           DateTime           @db.Date
  categoriaId    String             @map("categoria_id") @db.Uuid
  categoria      Categoria          @relation(fields: [categoriaId], references: [id], onDelete: Restrict)
  formaPagamento FormaPagamento     @map("forma_pagamento")
  origem         OrigemMovimentacao @default(MANUAL)
  descricao      String // ex.: "NF 685"

  // Vínculo de origem (no máximo um).
  contratoId    String?      @map("contrato_id") @db.Uuid
  contrato      Contrato?    @relation(fields: [contratoId], references: [id], onDelete: Restrict)
  projetoId     String?      @map("projeto_id") @db.Uuid
  projeto       Projeto?     @relation(fields: [projetoId], references: [id], onDelete: Restrict)
  funcionarioId String?      @map("funcionario_id") @db.Uuid
  funcionario   Funcionario? @relation(fields: [funcionarioId], references: [id], onDelete: Restrict)
  centroCustoId String?      @map("centro_custo_id") @db.Uuid
  centroCusto   CentroCusto? @relation(fields: [centroCustoId], references: [id], onDelete: Restrict)

  // Preenchido na movimentação espelho: aponta para a original que ela anula.
  // UNIQUE: uma movimentação só pode ser estornada uma vez.
  estornoDeId   String?       @unique @map("estorno_de_id") @db.Uuid
  estornoDe     Movimentacao? @relation("Estorno", fields: [estornoDeId], references: [id], onDelete: Restrict)
  estorno       Movimentacao? @relation("Estorno")
  motivoEstorno String?       @map("motivo_estorno")

  // Transferência entre contas (aplicar ou resgatar): duas movimentações de mesmo valor e
  // tipos opostos. A segunda perna aponta para a primeira. Não entram no resultado do CASD.
  transferenciaParId String?       @unique @map("transferencia_par_id") @db.Uuid
  transferenciaPar   Movimentacao? @relation("Transferencia", fields: [transferenciaParId], references: [id], onDelete: Restrict)
  transferenciaParDe Movimentacao? @relation("Transferencia")

  // Cobrança paga que gerou esta entrada (conciliação ou registro manual).
  cobranca Cobranca?

  dataCriacao   DateTime @default(now()) @map("data_criacao")
  dataAlteracao DateTime @updatedAt @map("data_alteracao")

  @@index([data])
  @@index([contaId])
  @@index([categoriaId])
  @@index([contratoId])
  @@index([projetoId])
  @@index([funcionarioId])
  @@index([centroCustoId])
  @@map("movimentacoes")
}

// ---------------------------------------------------------------------------
// Parâmetros de cobrança [Administração.RF003]
// ---------------------------------------------------------------------------

// Cada alteração grava uma linha nova; as antigas nunca mudam. A vigente é a mais recente.
// Assim fica o histórico (quem mudou, quando, de quanto para quanto), e as cobranças já emitidas
// não são afetadas. Regras garantidas por CHECK na migração: dias de 1 a 28, geração antes do
// vencimento, valor positivo, multa de 0 a 2% e juros de 0 a 1% ao mês.
model ParametrosCobranca {
  id                       String     @id @default(uuid()) @db.Uuid
  valorMensalidadeCentavos Int        @map("valor_mensalidade_centavos")
  diaVencimento            Int        @map("dia_vencimento")
  diaGeracao               Int        @map("dia_geracao")
  // Percentual inteiro (2 = 2%). Quem calcula multa e juros é o Asaas, no pagamento.
  multaPercentual          Int        @map("multa_percentual")
  jurosMensalPercentual    Int        @map("juros_mensal_percentual")
  // Onde entra o pagamento conciliado [Cobranças.RF005] passo 6: conta e categoria por origem da
  // cobrança. Opcionais (a conta pode ainda não existir); sem eles, a conciliação espera.
  contaRecebimentoId       String?    @map("conta_recebimento_id") @db.Uuid
  contaRecebimento         Conta?     @relation(fields: [contaRecebimentoId], references: [id], onDelete: Restrict)
  categoriaMensalidadeId   String?    @map("categoria_mensalidade_id") @db.Uuid
  categoriaMensalidade     Categoria? @relation("CategoriaMensalidade", fields: [categoriaMensalidadeId], references: [id], onDelete: Restrict)
  categoriaAvulsaId        String?    @map("categoria_avulsa_id") @db.Uuid
  categoriaAvulsa          Categoria? @relation("CategoriaAvulsa", fields: [categoriaAvulsaId], references: [id], onDelete: Restrict)
  alteradoPorId            String     @map("alterado_por_id") @db.Uuid
  alteradoPor              Usuario    @relation(fields: [alteradoPorId], references: [id], onDelete: Restrict)
  dataCriacao              DateTime   @default(now()) @map("data_criacao")

  @@index([dataCriacao])
  @@map("parametros_cobranca")
}

// ---------------------------------------------------------------------------
// Cobranças (dirigidas ao aluno, sempre criadas no Asaas)
// ---------------------------------------------------------------------------

// O cliente do Asaas que corresponde a cada aluno. Fica no módulo de Cobranças (e não no aluno)
// para o Cadastros não depender do Asaas.
model ClienteAsaas {
  alunoId     String   @id @map("aluno_id") @db.Uuid
  aluno       Aluno    @relation(fields: [alunoId], references: [id], onDelete: Restrict)
  idAsaas     String   @unique @map("id_asaas") // ex.: "cus_..."
  dataCriacao DateTime @default(now()) @map("data_criacao")

  @@map("clientes_asaas")
}

enum OrigemCobranca {
  MENSALIDADE
  AVULSA

  @@map("origem_cobranca")
}

// "Vencida" não é guardada: é uma cobrança aberta com o vencimento já passado (calculado na leitura).
enum SituacaoCobranca {
  ABERTA
  PAGA
  PAGA_COM_REGISTRO_MANUAL
  CANCELADA
  ESTORNADA

  @@map("situacao_cobranca")
}

// [Cobranças.RF001 a RF008]. Nenhuma cobrança existe só aqui: ela é gravada depois que o Asaas a
// criou, com o id dele. Multa e juros são os dos parâmetros no momento da emissão (o Asaas calcula).
// Regras garantidas por CHECK na migração: valor positivo, percentuais nos limites legais e cobrança
// paga sempre com data do pagamento e movimentação de entrada; paga à mão sempre com justificativa.
model Cobranca {
  id                    String           @id @default(uuid()) @db.Uuid
  idAsaas               String           @unique @map("id_asaas") // ex.: "pay_..."
  alunoId               String           @map("aluno_id") @db.Uuid
  aluno                 Aluno            @relation(fields: [alunoId], references: [id], onDelete: Restrict)
  origem                OrigemCobranca
  // Mês da mensalidade ("AAAA-MM"); nulo na avulsa. Único por aluno: a geração pode rodar duas vezes.
  referencia            String?          @db.Char(7)
  descricao             String
  valorCentavos         Int              @map("valor_centavos") // valor original, sem multa e juros
  vencimento            DateTime         @db.Date
  multaPercentual       Int              @map("multa_percentual")
  jurosMensalPercentual Int              @map("juros_mensal_percentual")
  situacao              SituacaoCobranca @default(ABERTA)
  urlBoleto             String?          @map("url_boleto")
  urlFatura             String?          @map("url_fatura")
  // Nulo = gerada por rotina automática.
  emitidaPorId          String?          @map("emitida_por_id") @db.Uuid
  emitidaPor            Usuario?         @relation(fields: [emitidaPorId], references: [id], onDelete: Restrict)
  // Preenchidos na baixa (mesma transação da movimentação de entrada) [Confiabilidade.NF004].
  pagaEm                DateTime?        @map("paga_em") @db.Date
  // [Cobranças.RF006]: por que a cobrança foi dada como paga à mão. Obrigatória nessa situação (CHECK).
  justificativaManual   String?          @map("justificativa_manual")
  // [Cobranças.RF005] fluxo A1: quando o valor ficou disponível na conta do Asaas (pode vir depois do pagamento).
  disponivelEm          DateTime?        @map("disponivel_em") @db.Date
  movimentacaoId        String?          @unique @map("movimentacao_id") @db.Uuid
  movimentacao          Movimentacao?    @relation(fields: [movimentacaoId], references: [id], onDelete: Restrict)
  canceladaEm           DateTime?        @map("cancelada_em")
  motivoCancelamento    String?          @map("motivo_cancelamento")
  // Renegociação [Cobranças.RF004] fluxo A1: a cobrança nova aponta para a cancelada que ela substitui.
  renegociacaoDeId      String?          @unique @map("renegociacao_de_id") @db.Uuid
  renegociacaoDe        Cobranca?        @relation("Renegociacao", fields: [renegociacaoDeId], references: [id], onDelete: Restrict)
  renegociadaPor        Cobranca?        @relation("Renegociacao")
  dataCriacao           DateTime         @default(now()) @map("data_criacao")
  dataAlteracao         DateTime         @updatedAt @map("data_alteracao")

  @@unique([alunoId, referencia])
  @@index([situacao, vencimento])
  @@map("cobrancas")
}

enum OrigemExecucao {
  AGENDADA
  MANUAL

  @@map("origem_execucao")
}

// Cada execução da geração recorrente [Cobranças.RF001], [Confiabilidade.NF007]: quando começou e
// terminou, quantas cobranças criou, quantas já existiam e quais alunos falharam (e por quê).
model ExecucaoGeracao {
  id                String         @id @default(uuid()) @db.Uuid
  referencia        String         @db.Char(7) // mês das mensalidades, "AAAA-MM"
  origem            OrigemExecucao
  iniciadaEm        DateTime       @default(now()) @map("iniciada_em")
  finalizadaEm      DateTime?      @map("finalizada_em")
  totalCriadas      Int            @default(0) @map("total_criadas")
  totalJaExistentes Int            @default(0) @map("total_ja_existentes")
  totalFalhas       Int            @default(0) @map("total_falhas")
  // Lista de { alunoId, alunoNome, motivo }.
  falhas            Json           @default("[]")
  // Verdadeiro quando o Asaas parou de responder no meio (fluxo E1): nova tentativa é agendada.
  interrompida      Boolean        @default(false)

  @@index([referencia, iniciadaEm])
  @@map("execucoes_geracao")
}

enum AmbienteAsaas {
  SANDBOX
  PRODUCAO

  @@map("ambiente_asaas")
}

// Configuração da integração com o Asaas [Administração.RF004]. Uma linha por alteração, nunca
// alterada; a vigente é a mais recente. A chave fica cifrada (AES-256-GCM, com a CHAVE_DE_CIFRAGEM do
// .env) e nunca volta para a tela, o log ou a trilha [Segurança.NF003].
model ConfiguracaoAsaas {
  id               String        @id @default(uuid()) @db.Uuid
  ambiente         AmbienteAsaas
  chaveCifrada     String        @map("chave_cifrada")
  // Após quantas horas sem notificações a diretoria é alertada (12, 24 ou 48) [Confiabilidade.NF002].
  prazoAlertaHoras Int           @map("prazo_alerta_horas")
  // Quando a comunicação com o Asaas foi testada com esta chave (antes de salvar).
  testadaEm        DateTime      @map("testada_em")
  alteradoPorId    String        @map("alterado_por_id") @db.Uuid
  alteradoPor      Usuario       @relation(fields: [alteradoPorId], references: [id], onDelete: Restrict)
  dataCriacao      DateTime      @default(now()) @map("data_criacao")

  @@index([dataCriacao])
  @@map("configuracoes_asaas")
}
