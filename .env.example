# Em desenvolvimento, deixe NODE_ENV comentado. Na Railway vale NODE_ENV=production: cookie Secure, sem
# /api/docs, a API serve o site e configuração inválida impede a subida (aqui só gera aviso no log).
# NODE_ENV=production
# Porta da API (a Railway injeta a dela; o proxy do Vite aponta para a 3000).
PORT=3000
DATABASE_URL=postgresql://integracasd:integracasd@localhost:5434/integracasd
ASAAS_AMBIENTE=sandbox
ASAAS_API_KEY=coloque-sua-chave-do-sandbox
ASAAS_WEBHOOK_TOKEN=coloque-um-token-aleatorio
CHAVE_DE_CIFRAGEM=gere-32-bytes-em-base64
ADMIN_INICIAL_NOME=Diretoria CASD
ADMIN_INICIAL_EMAIL=diretoria@casd.ita.br
ADMIN_INICIAL_SENHA=troque-por-uma-senha-forte
# Envio dos alertas por e-mail à diretoria (webhook parado). Opcional em desenvolvimento: sem estes dois, o
# alerta não sai e o motivo aparece no log do worker. Chave e remetente criados no provedor (Resend).
EMAIL_API_KEY=
EMAIL_REMETENTE=IntegraCASD <alertas@seu-dominio.com.br>
# Opcional: outro endereço da API do provedor de e-mail (padrão: https://api.resend.com).
# EMAIL_API_URL=
