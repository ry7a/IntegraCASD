  "info": {
    "title": "IntegraCASD",
    "description": "API do sistema de gestão financeira do CASD",
    "version": "0.0.1",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "cookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "integracasd_sessao"
      }
    },
    "schemas": {
      "LoginDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "diretoria@casd.ita.br"
          },
          "senha": {
            "type": "string",
            "minLength": 12,
            "writeOnly": true
          }
        },
        "required": [
          "email",
          "senha"
        ]
      },
      "UsuarioDaSessaoDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "nome": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "perfil": {
            "type": "string",
            "enum": [
              "ADMINISTRATIVO",
              "DIRETORIA"
            ]
          }
        },
        "required": [
          "id",
          "nome",
          "email",
          "perfil"
        ]
      },
      "UsuarioDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "nome": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "perfil": {
            "type": "string",
            "enum": [
              "ADMINISTRATIVO",
              "DIRETORIA"
            ]
          },
          "ativo": {
            "type": "boolean"
          },
          "ultimoAcessoEm": {
            "type": "string",
            "nullable": true
          }
        },
        "required": [
          "id",
          "nome",
          "email",
          "perfil",
          "ativo",
          "ultimoAcessoEm"
        ]
      },
      "ListaDeUsuariosDto": {
        "type": "object",
        "properties": {
          "itens": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/UsuarioDto"
            }
          }
        },
        "required": [
          "itens"
        ]
      },
      "CriarUsuarioDto": {
        "type": "object",
        "properties": {
          "nome": {
            "type": "string"
          },
          "email": {
            "type": "string",
            "example": "usuario@casd.ita.br"
          },
          "perfil": {
            "type": "string",
            "enum": [
              "ADMINISTRATIVO",
              "DIRETORIA"
            ]
          },
          "ativo": {
            "type": "boolean",
            "default": true
          },
          "senhaInicial": {
            "type": "string",
            "minLength": 12,
            "writeOnly": true
          }
        },
        "required": [
          "nome",
          "email",
          "perfil",
          "senhaInicial"
        ]
      },
      "AlterarUsuarioDto": {
        "type": "object",
        "properties": {
          "nome": {
            "type": "string"
          },
          "email": {
            "type": "string",
            "example": "usuario@casd.ita.br"
          },
          "perfil": {
            "type": "string",
            "enum": [
              "ADMINISTRATIVO",
              "DIRETORIA"
            ]
          },
          "ativo": {
            "type": "boolean"
          },
          "novaSenha": {
            "type": "string",
            "minLength": 12,
            "writeOnly": true
          }
        }
      },
      "TipoCategoria": {
        "type": "string",
        "enum": [
          "ENTRADA",
          "SAIDA",
          "AMBOS"
        ]
      },
      "CategoriaComUsoDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "nome": {
            "type": "string"
          },
          "tipo": {
            "allOf": [
              {
                "$ref": "#/components/schemas/TipoCategoria"
              }
            ]
          },
          "ativo": {
            "type": "boolean"
          },
          "quantidadeMovimentacoes": {
            "type": "number",
            "description": "Quantas movimentações usam esta categoria."
          }
        },
        "required": [
          "id",
          "nome",
          "tipo",
          "ativo",
          "quantidadeMovimentacoes"
        ]
      },
      "ListaDeCategoriasComUsoDto": {
        "type": "object",
        "properties": {
          "itens": {
            "description": "Ativas primeiro, depois as inativas.",
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CategoriaComUsoDto"
            }
          }
        },
        "required": [
          "itens"
        ]
      },
      "CriarCategoriaDto": {
        "type": "object",
        "properties": {
          "nome": {
            "type": "string",
            "minLength": 2,
            "maxLength": 60,
            "example": "Material de limpeza"
          },
          "tipo": {
            "allOf": [
              {
                "$ref": "#/components/schemas/TipoCategoria"
              }
            ]
          }
        },
        "required": [
          "nome",
          "tipo"
        ]
      },
      "AlterarCategoriaDto": {
        "type": "object",
        "properties": {
          "nome": {
            "type": "string",
            "minLength": 2,
            "maxLength": 60
          },
          "tipo": {
            "allOf": [
              {
                "$ref": "#/components/schemas/TipoCategoria"
              }
            ]
          },
          "ativo": {
            "type": "boolean",
            "description": "false inativa; true reativa."
          }
        }
      },
      "ParametrosVigentesDto": {
        "type": "object",
        "properties": {
          "valorMensalidadeCentavos": {
            "type": "number",
            "example": 8500
          },
          "diaVencimento": {
            "type": "number",
            "minimum": 1,
            "maximum": 28,
            "example": 10
          },
          "diaGeracao": {
            "type": "number",
            "minimum": 1,
            "maximum": 28,
            "example": 1,
            "description": "Precisa ser antes do dia de vencimento"
          },
          "multaPercentual": {
            "type": "number",
            "minimum": 0,
            "maximum": 2,
            "description": "Percentual inteiro (2 = 2%)"
          },
          "jurosMensalPercentual": {
            "type": "number",
            "minimum": 0,
            "maximum": 1,
            "description": "Percentual inteiro ao mês (1 = 1%)"
          },
          "alteradoEm": {
            "type": "string",
            "format": "date-time"
          },
          "alteradoPor": {
            "type": "string",
            "description": "Nome de quem fez a última alteração"
          }
        },
        "required": [
          "valorMensalidadeCentavos",
          "diaVencimento",
          "diaGeracao",
          "multaPercentual",
          "jurosMensalPercentual",
          "alteradoEm",
          "alteradoPor"
        ]
      },
      "ConferenciaDto": {
        "type": "object",
        "properties": {
          "proximaGeracao": {
            "type": "string",
            "format": "date"
          },
          "proximoVencimento": {
            "type": "string",
            "format": "date"
          },
          "alunosCobrados": {
            "type": "number",
            "description": "Alunos ativos com cadastro completo, que receberão a mensalidade"
          },
          "totalPrevistoCentavos": {
            "type": "number",
            "description": "Alunos cobrados x valor da mensalidade"
          }
        },
        "required": [
          "proximaGeracao",
          "proximoVencimento",
          "alunosCobrados",
          "totalPrevistoCentavos"
        ]
