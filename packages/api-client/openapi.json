  "info": {
    "title": "IntegraCASD",
    "description": "API do sistema de gestão financeira do CASD",
    "version": "0.0.1",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "cookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "integracasd_sessao"
      }
    },
    "schemas": {
      "LoginDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "diretoria@casd.ita.br"
          },
          "senha": {
            "type": "string",
            "minLength": 12,
            "writeOnly": true
          }
        },
        "required": [
          "email",
          "senha"
        ]
      },
      "UsuarioDaSessaoDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "nome": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "perfil": {
            "type": "string",
            "enum": [
              "ADMINISTRATIVO",
              "DIRETORIA"
            ]
          }
        },
        "required": [
          "id",
          "nome",
          "email",
          "perfil"
        ]
      },
      "UsuarioDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "nome": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "perfil": {
            "type": "string",
            "enum": [
              "ADMINISTRATIVO",
              "DIRETORIA"
            ]
          },
          "ativo": {
            "type": "boolean"
          },
          "ultimoAcessoEm": {
            "type": "string",
            "nullable": true
          }
        },
        "required": [
          "id",
          "nome",
          "email",
          "perfil",
          "ativo",
          "ultimoAcessoEm"
        ]
      },
      "ListaDeUsuariosDto": {
        "type": "object",
        "properties": {
          "itens": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/UsuarioDto"
            }
          }
        },
        "required": [
          "itens"
        ]
      },
      "CriarUsuarioDto": {
        "type": "object",
        "properties": {
          "nome": {
            "type": "string"
          },
          "email": {
            "type": "string",
            "example": "usuario@casd.ita.br"
          },
          "perfil": {
            "type": "string",
            "enum": [
              "ADMINISTRATIVO",
              "DIRETORIA"
            ]
          },
          "ativo": {
            "type": "boolean",
            "default": true
          },
          "senhaInicial": {
            "type": "string",
            "minLength": 12,
            "writeOnly": true
          }
        },
        "required": [
          "nome",
          "email",
          "perfil",
          "senhaInicial"
        ]
      },
      "AlterarUsuarioDto": {
        "type": "object",
        "properties": {
          "nome": {
            "type": "string"
          },
          "email": {
            "type": "string",
            "example": "usuario@casd.ita.br"
          },
          "perfil": {
            "type": "string",
            "enum": [
              "ADMINISTRATIVO",
              "DIRETORIA"
            ]
          },
          "ativo": {
            "type": "boolean"
          },
          "novaSenha": {
            "type": "string",
            "minLength": 12,
            "writeOnly": true
          }
        }
      },
      "TipoCategoria": {
        "type": "string",
        "enum": [
          "ENTRADA",
          "SAIDA",
          "AMBOS"
        ]
      },
      "CategoriaComUsoDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "nome": {
            "type": "string"
          },
          "tipo": {
            "allOf": [
              {
                "$ref": "#/components/schemas/TipoCategoria"
              }
            ]
          },
          "ativo": {
            "type": "boolean"
          },
          "quantidadeMovimentacoes": {
            "type": "number",
            "description": "Quantas movimentações usam esta categoria."
          }
        },
        "required": [
          "id",
          "nome",
          "tipo",
          "ativo",
          "quantidadeMovimentacoes"
        ]
      },
      "ListaDeCategoriasComUsoDto": {
        "type": "object",
        "properties": {
          "itens": {
            "description": "Ativas primeiro, depois as inativas.",
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CategoriaComUsoDto"
            }
          }
        },
        "required": [
          "itens"
        ]
      },
      "CriarCategoriaDto": {
        "type": "object",
        "properties": {
          "nome": {
            "type": "string",
            "minLength": 2,
            "maxLength": 60,
            "example": "Material de limpeza"
          },
          "tipo": {
            "allOf": [
              {
                "$ref": "#/components/schemas/TipoCategoria"
              }
            ]
          }
        },
        "required": [
          "nome",
          "tipo"
        ]
      },
      "AlterarCategoriaDto": {
        "type": "object",
        "properties": {
          "nome": {
            "type": "string",
            "minLength": 2,
            "maxLength": 60
          },
          "tipo": {
            "allOf": [
              {
                "$ref": "#/components/schemas/TipoCategoria"
              }
            ]
          },
          "ativo": {
            "type": "boolean",
            "description": "false inativa; true reativa."
          }
        }
      },
      "SituacaoAluno": {
        "type": "string",
        "enum": [
          "MATRICULADO",
          "TRANCADO",
          "DESLIGADO",
          "FORMADO",
          "INTERCAMBIO"
        ]
      },
      "AlunoResumoDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "nome": {
            "type": "string"
          },
          "cpf": {
            "type": "string",
            "description": "Só dígitos, sem pontuação",
            "example": "12345678901"
          },
          "email": {
            "type": "string"
          },
          "turma": {
            "type": "string",
            "nullable": true,
            "example": "T28"
          },
          "situacao": {
            "nullable": true,
            "allOf": [
              {
                "$ref": "#/components/schemas/SituacaoAluno"
              }
            ]
          }
        },
        "required": [
          "id",
          "nome",
          "cpf",
          "email",
          "turma",
          "situacao"
        ]
      },
      "ListaDeAlunosDto": {
        "type": "object",
        "properties": {
          "itens": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AlunoResumoDto"
            }
          }
        },
        "required": [
          "itens"
        ]
      }
    }
  }
}
