          "diaGeracao": {
            "type": "number",
            "minimum": 1,
            "maximum": 28,
            "example": 1,
            "description": "Precisa ser antes do dia de vencimento"
          },
          "multaPercentual": {
            "type": "number",
            "minimum": 0,
            "maximum": 2,
            "description": "Percentual inteiro (2 = 2%)"
          },
          "jurosMensalPercentual": {
            "type": "number",
            "minimum": 0,
            "maximum": 1,
            "description": "Percentual inteiro ao mês (1 = 1%)"
          }
