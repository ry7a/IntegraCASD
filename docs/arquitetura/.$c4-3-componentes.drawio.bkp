<mxfile host="app.diagrams.net"><diagram name="Componentes" id="Componentes"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1100" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="titulo" value="IntegraCASD · Nível 3: Componentes da API e do Worker" style="text;html=1;fontSize=18;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="0" width="800" height="30" as="geometry" /></mxCell><mxCell id="spa" value="&lt;b&gt;SPA&lt;/b&gt;&lt;br&gt;&lt;i&gt;&lt;font style='font-size:10px'&gt;[Container: React 19]&lt;/font&gt;&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fontSize=12;fillColor=#438DD5;fontColor=#FFFFFF;strokeColor=#3C7FC0;" vertex="1" parent="1"><mxGeometry x="80" y="50" width="260" height="80" as="geometry" /></mxCell><mxCell id="asaas" value="&lt;b&gt;Asaas&lt;/b&gt;&lt;br&gt;&lt;i&gt;&lt;font style='font-size:10px'&gt;[Sistema externo]&lt;/font&gt;&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fontSize=12;fillColor=#999999;fontColor=#FFFFFF;strokeColor=#8A8A8A;" vertex="1" parent="1"><mxGeometry x="1220" y="440" width="200" height="100" as="geometry" /></mxCell><mxCell id="fronteira" value="API e Worker [Container: NestJS 12]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;dashed=1;strokeColor=#444444;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontStyle=1;fontSize=13;arcSize=2;" vertex="1" parent="1"><mxGeometry x="40" y="180" width="1100" height="620" as="geometry" /></mxCell><mxCell id="rest" value="&lt;b&gt;Controllers REST&lt;/b&gt;&lt;br&gt;&lt;i&gt;&lt;font style='font-size:10px'&gt;[Componente: NestJS]&lt;/font&gt;&lt;/i&gt;&lt;br&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;Recebem as requisições da SPA&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fontSize=12;fillColor=#85BBF0;fontColor=#000000;strokeColor=#78A8D8;" vertex="1" parent="1"><mxGeometry x="80" y="230" width="260" height="100" as="geometry" /></mxCell><mxCell id="wh" value="&lt;b&gt;Receptor do webhook&lt;/b&gt;&lt;br&gt;&lt;i&gt;&lt;font style='font-size:10px'&gt;[Componente: NestJS]&lt;/font&gt;&lt;/i&gt;&lt;br&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;Valida o token, grava o evento e enfileira&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fontSize=12;fillColor=#85BBF0;fontColor=#000000;strokeColor=#78A8D8;" vertex="1" parent="1"><mxGeometry x="440" y="230" width="260" height="100" as="geometry" /></mxCell><mxCell id="jobs" value="&lt;b&gt;Handlers de jobs&lt;/b&gt;&lt;br&gt;&lt;i&gt;&lt;font style='font-size:10px'&gt;[Componente: pg-boss]&lt;/font&gt;&lt;/i&gt;&lt;br&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;Executam os jobs da fila (só no worker)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fontSize=12;fillColor=#85BBF0;fontColor=#000000;strokeColor=#78A8D8;" vertex="1" parent="1"><mxGeometry x="800" y="230" width="260" height="100" as="geometry" /></mxCell><mxCell id="grupo" value="Módulos de domínio (casos de uso e regras de negócio)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#BBBBBB;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=11;fontColor=#555555;arcSize=3;" vertex="1" parent="1"><mxGeometry x="60" y="380" width="1060" height="160" as="geometry" /></mxCell><mxCell id="m_cad" value="&lt;b&gt;Cadastros&lt;/b&gt;&lt;br&gt;&lt;i&gt;&lt;font style='font-size:10px'&gt;[Módulo]&lt;/font&gt;&lt;/i&gt;&lt;br&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;Alunos, funcionários, fornecedores, contratos, projetos&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fontSize=12;fillColor=#85BBF0;fontColor=#000000;strokeColor=#78A8D8;" vertex="1" parent="1"><mxGeometry x="80" y="415" width="180" height="110" as="geometry" /></mxCell><mxCell id="m_cob" value="&lt;b&gt;Cobranças&lt;/b&gt;&lt;br&gt;&lt;i&gt;&lt;font style='font-size:10px'&gt;[Módulo]&lt;/font&gt;&lt;/i&gt;&lt;br&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;Ciclo de vida da cobrança e conciliação&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fontSize=12;fillColor=#85BBF0;fontColor=#000000;strokeColor=#78A8D8;" vertex="1" parent="1"><mxGeometry x="290" y="415" width="180" height="110" as="geometry" /></mxCell><mxCell id="m_mov" value="&lt;b&gt;Movimentações&lt;/b&gt;&lt;br&gt;&lt;i&gt;&lt;font style='font-size:10px'&gt;[Módulo]&lt;/font&gt;&lt;/i&gt;&lt;br&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;Entradas, saídas e estornos&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fontSize=12;fillColor=#85BBF0;fontColor=#000000;strokeColor=#78A8D8;" vertex="1" parent="1"><mxGeometry x="500" y="415" width="180" height="110" as="geometry" /></mxCell><mxCell id="m_ind" value="&lt;b&gt;Indicadores&lt;/b&gt;&lt;br&gt;&lt;i&gt;&lt;font style='font-size:10px'&gt;[Módulo]&lt;/font&gt;&lt;/i&gt;&lt;br&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;Painel, inadimplência e gastos (só leitura)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fontSize=12;fillColor=#85BBF0;fontColor=#000000;strokeColor=#78A8D8;" vertex="1" parent="1"><mxGeometry x="710" y="415" width="180" height="110" as="geometry" /></mxCell><mxCell id="m_adm" value="&lt;b&gt;Administração&lt;/b&gt;&lt;br&gt;&lt;i&gt;&lt;font style='font-size:10px'&gt;[Módulo]&lt;/font&gt;&lt;/i&gt;&lt;br&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;Usuários, categorias, parâmetros, integração&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fontSize=12;fillColor=#85BBF0;fontColor=#000000;strokeColor=#78A8D8;" vertex="1" parent="1"><mxGeometry x="920" y="415" width="180" height="110" as="geometry" /></mxCell><mxCell id="acesso" value="&lt;b&gt;Acesso e auditoria&lt;/b&gt;&lt;br&gt;&lt;i&gt;&lt;font style='font-size:10px'&gt;[Componente transversal]&lt;/font&gt;&lt;/i&gt;&lt;br